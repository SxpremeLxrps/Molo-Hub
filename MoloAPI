--// MoloAPI - Drawing Circle GUI implementation

local MoloAPI = {}

export type Object = {
	Remove: (self: Object) -> (),
	Name: string,
	ClassName: string,

	Visible: boolean,
	ZIndex: number,
	Transparency: number,
	Color: Color3,
	Thickness: number,
	NumSides: number,
	Radius: number,
	Filled: boolean,
	Position: Vector2,
}

export type API = {
	new: (Type: string) -> Object,

	Fonts: {
		UI: number,
		System: number,
		Plex: number,
		Monospace: number,
	},

	Properties: {[string]: any},
}

--// Fonts
MoloAPI.Fonts = {
	UI = 0,
	System = 1,
	Plex = 2,
	Monospace = 3,
}

--// Supported properties
MoloAPI.Properties = {
	Default = {
		Drawing = {
			Visible = "boolean",
			ZIndex = "number",
			Transparency = "number",
		},

		Object = {
			Name = "string",
			ClassName = "string",
		},
	},

	Circle = {
		Color = "Color3",
		Thickness = "number",
		NumSides = "number",
		Radius = "number",
		Filled = "boolean",
		Position = "Vector2",
	},
}

--// Services
local Players = game:GetService("Players")

local Player = Players.LocalPlayer

if not Player then
	error("MoloAPI must run on the client")
end

local PlayerGui = Player:WaitForChild("PlayerGui")

--// Drawing GUI
local DrawingGui = PlayerGui:FindFirstChild("MoloDrawing")

if not DrawingGui then
	DrawingGui = Instance.new("ScreenGui")
	DrawingGui.Name = "MoloDrawing"
	DrawingGui.IgnoreGuiInset = true
	DrawingGui.ResetOnSpawn = false
	DrawingGui.DisplayOrder = 10000
	DrawingGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	DrawingGui.Parent = PlayerGui
end

--// Circle
local function CreateCircle(): Object
	local Container = Instance.new("Frame")

	Container.Name = "Circle"
	Container.AnchorPoint = Vector2.new(0.5, 0.5)
	Container.BackgroundTransparency = 1
	Container.BorderSizePixel = 0
	Container.Size = UDim2.fromOffset(300, 300)
	Container.Position = UDim2.fromOffset(0, 0)
	Container.Visible = true
	Container.ZIndex = 0
	Container.Parent = DrawingGui

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(1, 0)
	Corner.Parent = Container

	local Stroke = Instance.new("UIStroke")
	Stroke.Thickness = 1.5
	Stroke.Transparency = 0.5
	Stroke.Color = Color3.fromRGB(255, 8, 169)
	Stroke.Parent = Container

	--// IMPORTANT:
	--// Keep actual values outside Object so __newindex
	--// fires every time a public property is changed.
	local Data = {
		Name = "Circle",
		ClassName = "Circle",

		Visible = true,
		ZIndex = 0,
		Transparency = 0.5,
		Color = Color3.fromRGB(255, 8, 169),

		Thickness = 1.5,
		NumSides = 64,
		Radius = 150,

		Filled = false,
		Position = Vector2.zero,
	}

	local Removed = false

	local Object = {} :: any

	--// Update size
	local function UpdateSize()
		if Removed then
			return
		end

		local Diameter = math.max(0, Data.Radius * 2)

		Container.Size = UDim2.fromOffset(
			Diameter,
			Diameter
		)
	end

	--// Update position
	local function UpdatePosition()
		if Removed then
			return
		end

		Container.Position = UDim2.fromOffset(
			Data.Position.X,
			Data.Position.Y
		)
	end

	--// Update visual properties
	local function UpdateVisual()
		if Removed then
			return
		end

		Container.Visible = Data.Visible
		Container.ZIndex = Data.ZIndex

		Stroke.Color = Data.Color
		Stroke.Thickness = math.max(0, Data.Thickness)

		local Transparency = math.clamp(
			Data.Transparency,
			0,
			1
		)

		Stroke.Transparency = Transparency

		if Data.Filled then
			Container.BackgroundColor3 = Data.Color
			Container.BackgroundTransparency = Transparency
		else
			Container.BackgroundTransparency = 1
		end
	end

	--// Remove
	function Object:Remove()
		if Removed then
			return
		end

		Removed = true

		if Container then
			Container:Destroy()
		end

		table.clear(Data)
		table.clear(Object)
	end

	--// Property access
	setmetatable(Object, {
		__index = function(_, Key)
			return Data[Key]
		end,

		__newindex = function(_, Key, Value)
			if Removed then
				return
			end

			Data[Key] = Value

			if Key == "Radius" then
				UpdateSize()

			elseif Key == "Position" then
				UpdatePosition()

			elseif
				Key == "Visible"
				or Key == "ZIndex"
				or Key == "Transparency"
				or Key == "Color"
				or Key == "Thickness"
				or Key == "Filled"
			then
				UpdateVisual()
			end
		end,
	})

	--// Initial state
	UpdateSize()
	UpdatePosition()
	UpdateVisual()

	return Object
end

--// Create object
local function CreateObject(Type: string): Object
	assert(
		MoloAPI.Properties[Type],
		`Unsupported object type: {Type}`
	)

	if Type == "Circle" then
		return CreateCircle()
	end

	error(`Object type "{Type}" is not implemented`)
end

--// Public constructor
function MoloAPI.new(Type: string): Object
	return CreateObject(Type)
end

return MoloAPI :: API
