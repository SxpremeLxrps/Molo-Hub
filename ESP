-- [[ ESP ]]

local ESP: {any} = {}

local Players: Players = game:GetService("Players")
local Player: Player = Players.LocalPlayer
local Camera: Camera = workspace.CurrentCamera
local PlayerGui: PlayerGui = Player:WaitForChild("PlayerGui")
local RunService: RunService = game:GetService("RunService")

type ESPObject = {
	Highlight: Highlight?,
	NameTag: BillboardGui?,
	NameLabel: TextLabel?,
	Arrow: TextLabel?,
	HealthLabel: TextLabel?,
	Connections: {RBXScriptConnection}
}

ESP.Objects = {} :: {[Player]: ESPObject}
ESP.Enabled = false
ESP.Connection = nil :: RBXScriptConnection?

local ScreenGui: ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "MoloHubESP"
ScreenGui.IgnoreGuiInset = true
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.Parent = PlayerGui

local function CreateTextLabel(
	Parent: Instance,
	Name: string,
	TextSize: number
): TextLabel
	local Label: TextLabel = Instance.new("TextLabel")

	Label.Name = Name
	Label.BackgroundTransparency = 1
	Label.Size = UDim2.fromScale(1, 1)
	Label.Font = Enum.Font.GothamBold
	Label.TextColor3 = Color3.fromRGB(255, 255, 255)
	Label.TextSize = TextSize
	Label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	Label.TextStrokeTransparency = 0.25
	Label.Parent = Parent

	return Label
end

function ESP:Remove(TargetPlayer: Player): ()
	local Object: ESPObject? = self.Objects[TargetPlayer]

	if not Object then
		return
	end

	for _, Connection: RBXScriptConnection in Object.Connections do
		Connection:Disconnect()
	end

	if Object.Highlight then
		Object.Highlight:Destroy()
	end

	if Object.NameTag then
		Object.NameTag:Destroy()
	end

	if Object.Arrow then
		Object.Arrow:Destroy()
	end

	self.Objects[TargetPlayer] = nil
end

function ESP:Add(TargetPlayer: Player): ()
	if TargetPlayer == Player then
		return
	end

	self:Remove(TargetPlayer)

	local Character: Model? = TargetPlayer.Character

	if not Character then
		return
	end

	local Head: BasePart? = Character:FindFirstChild("Head")

	if not Head then
		return
	end

	local Connections: {RBXScriptConnection} = {}

	local Highlight: Highlight = Instance.new("Highlight")
	Highlight.Name = "MoloHubHighlight"
	Highlight.Adornee = Character
	Highlight.FillColor = Color3.fromRGB(255, 0, 0)
	Highlight.FillTransparency = 0.35
	Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	Highlight.OutlineTransparency = 0.25
	Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	Highlight.Parent = Character

	local NameTag: BillboardGui = Instance.new("BillboardGui")
	NameTag.Name = "MoloHubName"
	NameTag.Adornee = Head
	NameTag.AlwaysOnTop = true
	NameTag.Size = UDim2.fromOffset(220, 55)
	NameTag.StudsOffset = Vector3.new(0, 3, 0)
	NameTag.Parent = ScreenGui

	local NameLabel: TextLabel = CreateTextLabel(
		NameTag,
		"Username",
		14
	)

	NameLabel.Text = TargetPlayer.Name
	NameLabel.Size = UDim2.new(1, 0, 0.55, 0)

	local HealthLabel: TextLabel = CreateTextLabel(
		NameTag,
		"Health",
		12
	)

	HealthLabel.Position = UDim2.new(0, 0, 0.5, 0)
	HealthLabel.Size = UDim2.new(1, 0, 0.5, 0)
	HealthLabel.Font = Enum.Font.Gotham

	local Arrow: TextLabel = Instance.new("TextLabel")

	Arrow.Name = "MoloHubArrow"
	Arrow.AnchorPoint = Vector2.new(0.5, 0.5)
	Arrow.BackgroundTransparency = 1
	Arrow.Size = UDim2.fromOffset(35, 35)
	Arrow.Font = Enum.Font.GothamBold
	Arrow.Text = "▲"
	Arrow.TextColor3 = Color3.fromRGB(255, 0, 0)
	Arrow.TextSize = 26
	Arrow.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	Arrow.TextStrokeTransparency = 0.2
	Arrow.Visible = false
	Arrow.ZIndex = 100
	Arrow.Parent = ScreenGui

	table.insert(
		Connections,
		TargetPlayer.CharacterAdded:Connect(function()
			if self.Enabled then
				task.wait()
				self:Add(TargetPlayer)
			end
		end)
	)

	self.Objects[TargetPlayer] = {
		Highlight = Highlight,
		NameTag = NameTag,
		NameLabel = NameLabel,
		Arrow = Arrow,
		HealthLabel = HealthLabel,
		Connections = Connections
	}
end

function ESP:Enable(): ()
	if self.Enabled then
		return
	end

	self.Enabled = true

	for _, TargetPlayer: Player in Players:GetPlayers() do
		self:Add(TargetPlayer)
	end

	if not self.Connection then
		self.Connection = RunService.RenderStepped:Connect(function()
			self:Update()
		end)
	end
end

function ESP:Disable(): ()
	if not self.Enabled then
		return
	end

	self.Enabled = false

	for TargetPlayer: Player in pairs(self.Objects) do
		self:Remove(TargetPlayer)
	end
end

function ESP:Toggle(): ()
	if self.Enabled then
		self:Disable()
	else
		self:Enable()
	end
end

function ESP:Refresh(): ()
	if not self.Enabled then
		return
	end

	for TargetPlayer: Player in pairs(self.Objects) do
		self:Remove(TargetPlayer)
	end

	for _, TargetPlayer: Player in Players:GetPlayers() do
		self:Add(TargetPlayer)
	end
end

function ESP:Update(): ()
	if not self.Enabled then
		return
	end

	Camera = workspace.CurrentCamera

	if not Camera then
		return
	end

	local ViewportSize: Vector2 = Camera.ViewportSize
	local Center: Vector2 = ViewportSize / 2

	for TargetPlayer, Object: ESPObject in pairs(self.Objects) do
		local Character: Model? = TargetPlayer.Character
		local Arrow: TextLabel? = Object.Arrow
		local NameTag: BillboardGui? = Object.NameTag
		local HealthLabel: TextLabel? = Object.HealthLabel

		if not Character then
			if Arrow then
				Arrow.Visible = false
			end

			if NameTag then
				NameTag.Enabled = false
			end

			continue
		end

		local Humanoid: Humanoid? =
			Character:FindFirstChildOfClass("Humanoid")

		local RootPart: BasePart? =
			Character:FindFirstChild("HumanoidRootPart")

		local Head: BasePart? =
			Character:FindFirstChild("Head")

		if not Humanoid or not RootPart or not Head then
			if Arrow then
				Arrow.Visible = false
			end

			continue
		end

		if NameTag then
			NameTag.Enabled = true
		end

		if HealthLabel then
			HealthLabel.Text = string.format(
				"HP: %d / %d",
				math.floor(Humanoid.Health),
				math.floor(Humanoid.MaxHealth)
			)
		end

		local Distance: number =
			(RootPart.Position - Camera.CFrame.Position).Magnitude

		if Object.NameLabel then
			Object.NameLabel.Text = string.format(
				"%s  [%d]",
				TargetPlayer.Name,
				math.floor(Distance)
			)
		end

		local ScreenPosition: Vector3, OnScreen: boolean =
			Camera:WorldToViewportPoint(RootPart.Position)

		if OnScreen and ScreenPosition.Z > 0 then
			if Arrow then
				Arrow.Visible = false
			end

			continue
		end

		if not Arrow then
			continue
		end

		local Direction: Vector2 =
			Vector2.new(ScreenPosition.X, ScreenPosition.Y) - Center

		if ScreenPosition.Z < 0 then
			Direction = -Direction
		end

		if Direction.Magnitude <= 0 then
			Arrow.Visible = false
			continue
		end

		Direction = Direction.Unit

		local Margin: number = 45

		local HalfWidth: number =
			ViewportSize.X / 2 - Margin

		local HalfHeight: number =
			ViewportSize.Y / 2 - Margin

		local ScaleX: number =
			math.abs(Direction.X) > 0
			and HalfWidth / math.abs(Direction.X)
			or math.huge

		local ScaleY: number =
			math.abs(Direction.Y) > 0
			and HalfHeight / math.abs(Direction.Y)
			or math.huge

		local Scale: number = math.min(ScaleX, ScaleY)

		local Position: Vector2 =
			Center + Direction * Scale

		Position = Vector2.new(
			math.clamp(Position.X, Margin, ViewportSize.X - Margin),
			math.clamp(Position.Y, Margin, ViewportSize.Y - Margin)
		)

		Arrow.Position = UDim2.fromOffset(
			Position.X,
			Position.Y
		)

		Arrow.Rotation =
			math.deg(math.atan2(Direction.Y, Direction.X)) + 90

		Arrow.Visible = true
	end
end

Players.PlayerAdded:Connect(function(TargetPlayer: Player)
	if ESP.Enabled then
		TargetPlayer.CharacterAdded:Wait()

		if ESP.Enabled then
			ESP:Add(TargetPlayer)
		end
	end
end)

Players.PlayerRemoving:Connect(function(TargetPlayer: Player)
	ESP:Remove(TargetPlayer)
end)

function ESP:Destroy(): ()
	self:Disable()

	if self.Connection then
		self.Connection:Disconnect()
		self.Connection = nil
	end

	ScreenGui:Destroy()
end

return ESP
